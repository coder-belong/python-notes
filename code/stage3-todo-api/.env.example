# .env.example：提交到仓库的模板，复制一份改名成 .env 再改成自己的值
# 格式：postgresql+psycopg://用户名:密码@主机:端口/库名
# 本机 brew 装的 Postgres 不用写用户名和密码，下面这行直接能用
DATABASE_URL=postgresql+psycopg://localhost:5432/stage3_todo
DEBUG=false
JWT_SECRET=换成你自己的随机字符串
TOKEN_DAYS=7
# 允许跨域的前端网址，JSON 格式；不写就用默认的 ["http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:5173"]
